---
import '../styles/tokens.css';
import '../styles/acs-tokens.css';
import '../styles/fonts.css';
import '../styles/site.css';
import '../styles/cover.css';
import '../styles/atmosphere.css';
import { bootScript } from '../lib/boot';
import { ATMOSPHERE_STORAGE_KEY, BUILD_DEFAULT } from '../lib/atmosphere/level';
interface Props { title?: string; description?: string; path?: string; coverSlugs?: readonly string[] }
const {
  title = 'Deepwell — A cozy reader for the SCP Wiki',
  description = 'Read the SCP Wiki the way it deserves — offline, distraction-free, beautifully set. 19,000+ anomalies, three themes, always free to read. An unofficial reader.',
  path = '/',
  coverSlugs = [],
} = Astro.props;
const canonical = new URL(path, Astro.site).href;
---
<!doctype html>
<html lang="en" data-theme="dark" data-atmosphere={BUILD_DEFAULT}>
  <head>
    <meta charset="utf-8" />
    <script is:inline set:html={bootScript({ storageKey: ATMOSPHERE_STORAGE_KEY, buildDefault: BUILD_DEFAULT, slugs: coverSlugs })} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#131019" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/literata-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content="Deepwell — a terminal into the archive" />
    <meta property="og:description" content="A typography-first, offline reader for the SCP Wiki. Free to read, no ads, no tracking. Secure. Contain. Peruse." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Deepwell — a terminal into the archive" />
    <meta name="twitter:description" content="A typography-first, offline reader for the SCP Wiki. Free to read, no ads, no tracking. Secure. Contain. Peruse." />
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
