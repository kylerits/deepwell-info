---
// PORTED from ~/git_local/deepwell/apps/web/src/lib/render/AcsIcon.svelte on 2026-10-08
// (modified: Svelte → Astro; containment/disruption/risk axes; clearance glyph unused here).
import { OBJECT_CLASS_TAGS, disruptionClassOf, riskClassOf } from '../../lib/cover/classification';
interface Props { axis: 'containment' | 'disruption' | 'risk'; value: string }
const { axis, value } = Astro.props;
const v = value.trim().toLowerCase();
const token = axis === 'containment' ? ((OBJECT_CLASS_TAGS as readonly string[]).includes(v) ? v : null)
  : axis === 'disruption' ? disruptionClassOf(value) : riskClassOf(value);
---
<svg class="acs-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-acs={`${axis}:${token ?? 'unknown'}`}>
  {axis === 'containment' && (
    token === 'safe' ? <><rect x="6" y="11" width="12" height="9" rx="1.4" /><path d="M9 11 V8.5 A3 3 0 0 1 15 8.5 V11" /><circle cx="12" cy="15.5" r="1.1" fill="currentColor" stroke="none" /></>
    : token === 'euclid' ? <><path d="M3 12 Q12 5.5 21 12 Q12 18.5 3 12 Z" /><circle cx="12" cy="12" r="2.4" /></>
    : token === 'keter' ? <path d="M12 4 V20 M4 12 H20 M6.3 6.3 L17.7 17.7 M17.7 6.3 L6.3 17.7" />
    : token === 'thaumiel' ? <><path d="M12 3.5 L19 6.2 V12 Q19 17.5 12 20.5 Q5 17.5 5 12 V6.2 Z" /><path d="M9 12 L11.2 14.2 L15 9.8" /></>
    : token === 'neutralized' ? <><circle cx="12" cy="12" r="7.5" /><path d="M6.7 6.7 L17.3 17.3" /></>
    : token === 'apollyon' ? <><path d="M16.5 6.5 A7 7 0 1 0 18 13.5" /><path d="M17 5 L20 3 M19 9 L22 8.5 M18.5 12 L21.5 12.5" /></>
    : token === 'explained' ? <><path d="M12 6.5 Q8 4.5 4 6 V18 Q8 16.5 12 18 Q16 16.5 20 18 V6 Q16 4.5 12 6.5 Z" /><path d="M12 6.5 V18" /></>
    : token === 'archon' ? <><path d="M9.5 5 H7 V19 H9.5" /><path d="M14.5 5 H17" /><path d="M14.5 19 H17" /></>
    : <rect x="6" y="6" width="12" height="12" rx="1.4" />
  )}
  {axis === 'disruption' && (
    token === 'dark' ? <path d="M5 12 H19" />
    : token === 'vlam' ? <path d="M12 5 L13.4 10.6 L19 12 L13.4 13.4 L12 19 L10.6 13.4 L5 12 L10.6 10.6 Z" />
    : token === 'keneq' ? <><path d="M7 15 Q12 10.5 17 15" /><path d="M5 17.5 Q12 9 19 17.5" /></>
    : token === 'ekhi' ? <><circle cx="12" cy="12" r="3.6" /><path d="M12 3.5 V6 M12 18 V20.5 M3.5 12 H6 M18 12 H20.5 M6.3 6.3 L8 8 M16 16 L17.7 17.7 M17.7 6.3 L16 8 M8 16 L6.3 17.7" /></>
    : token === 'amida' ? <><circle cx="12" cy="12" r="2.4" fill="currentColor" stroke="none" /><path d="M12 2.5 V7 M12 17 V21.5 M2.5 12 H7 M17 12 H21.5 M5.5 5.5 L8.6 8.6 M15.4 15.4 L18.5 18.5 M18.5 5.5 L15.4 8.6 M8.6 15.4 L5.5 18.5" /></>
    : <circle cx="12" cy="12" r="2" />
  )}
  {axis === 'risk' && (
    token === 'notice' ? <><circle cx="12" cy="12" r="7" /><path d="M12 11 V16" /><circle cx="12" cy="8.4" r="1" fill="currentColor" stroke="none" /></>
    : token === 'caution' ? <path d="M12 5 L20 19 H4 Z" />
    : token === 'warning' ? <><path d="M12 5 L20 19 H4 Z" fill="currentColor" stroke="none" /><path d="M12 10 V14" stroke="#131019" /><circle cx="12" cy="16.4" r="0.9" fill="#131019" stroke="none" /></>
    : token === 'danger' ? <><path d="M12 4 L20 12 L12 20 L4 12 Z" /><path d="M12 8.5 V13" /><circle cx="12" cy="15.6" r="1" fill="currentColor" stroke="none" /></>
    : token === 'critical' ? <><path d="M12 4 L20 12 L12 20 L4 12 Z" fill="currentColor" stroke="none" /><path d="M12 8.5 V13" stroke="#131019" /><circle cx="12" cy="15.6" r="1" fill="#131019" stroke="none" /></>
    : <path d="M12 5 L20 19 H4 Z" />
  )}
</svg>
