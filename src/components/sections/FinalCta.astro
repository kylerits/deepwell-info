---
import { LAUNCH_STATE } from '../../config/launch';
import { APP_URL } from '../../config/site';
---
<section class="sec sec--cta" id="start" aria-labelledby="cta-h" data-depth="0.96">
  <div class="tube tube--side" aria-hidden="true"></div>
  <div class="wrap"><div class="col">
    <p class="eyebrow">END OF ORIENTATION</p>
    <h2 class="h-deep" id="cta-h">Go deeper.</h2>
    <p class="narr recede">Orientation is complete. The archive is not. 19,000+ files remain, catalogued for your comfort. Do sleep afterward.</p>
    <div data-launch-slot="final">
      {LAUNCH_STATE === 'public'
        ? <div class="cta-row"><a class="btn" href={APP_URL}>Start reading — free</a></div>
        : <div data-waitlist-placeholder></div>}
    </div>
  </div></div>
</section>
