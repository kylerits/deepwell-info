---
import { FAQ } from '../../data/faq';
---
<section class="sec" id="faq" aria-labelledby="faq-h" data-depth="0.82" data-scene="faq">
<div class="wrap smudge">
<h2 class="eyebrow" id="faq-h">STANDARD QUESTIONS FROM NEW PERSONNEL</h2>
<div class="faq">
{FAQ.map(({ q, a }) => <div class="faq__item"><h3 class="faq__q">{q}</h3><p class="faq__a">{a}</p></div>)}
</div>
</div>
</section>
